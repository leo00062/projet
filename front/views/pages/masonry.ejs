<head>
  <link rel="stylesheet" href="<%= process.env.SITE_URL%>/assets/styles/masonry.css" />
  <script type="module" src="<%= process.env.SITE_URL%>/assets/js/lightbox/lightbox.js"></script>
</head>

<%- include('../partials/header', { tittle: 'Galerie'}) %>

<main>
  <h1>Galerie</h1>
  <!-- js natif -->
  <ul class="masonry-grid">
    <% images.forEach((image) => { %>
    <!-- fin js natif -->
    <!-- html natif -->
    <li class="masonry-item">
      <img src="<%= image.urls.regular%>" alt="<%= image.alt_description %>" />
    </li>
    <!-- fin html natif -->
    <%  }) %>
  </ul>
  <div id="lightbox">
    <span class="close">&#x2716;</span>
    <img src="" alt="" class="lightbox-content" id="lightbox-img">
  </div>
</main>

<%- include('../partials/footer') %>