<head>
  <link rel="stylesheet" href="<%= process.env.SITE_URL %>/assets/styles/contact.css" />
  <script type="module" src="<%= process.env.SITE_URL %>/assets/js/contact.js"></script>
</head>

<%- include('../partials/header', { title: 'Contact'}) %>

<main>
  <section id="contact-form">
    <h1>Nous contacter</h1>
    <form id="form-contact" novalidate>
      <div class="form-group">
        <label for="name">
          Nom : </label>
        <div class="input-wrapper">
          <input type="text" id="name" name="name" placeholder="Entrez votre nom" />
          <i class="validation-icon"></i>
        </div>
        <span class="error" id="error-name"></span>
      </div>

      <div class="form-group">
        <label for="prenom">
          Prenom: </label>
        <div class="input-wrapper">
          <input type="text" id="prenom" name="prenom" placeholder="Entrez votre prenom" />
          <i class="validation-icon"></i>
        </div>
        <span class="error" id="error-prenom"></span>
      </div>

      <div class="form-group">
        <label for="email">
          Email : </label>
        <div class="input-wrapper">
          <input type="text" id="email" name="email" placeholder="Entrez votre email" />
          <i class="validation-icon"></i>
        </div>
        <span class="error" id="error-email"></span>
      </div>
      <div class="form-group">
        <label for="subject">
          Subject : </label>
        <div class="input-wrapper">
          <input type="text" id="subject" placeholder="Entrez votre subject" />
          <i class="validation-icon"></i>
        </div>
        <span class="error" id="error-subject"></span>
      </div>
      <div class="form-group">
        <label for="message">
          Message : </label>
        <div class="input-wrapper">
          <textarea id="message" placeholder="Entrez votre message"></textarea>
          <i class="validation-icon"></i>
        </div>
        <span class="error" id="error-message"></span>
      </div>
      <button type="submit" class="submit">Envoyer</button>
    </form>
    <div id="response-message"></div>
  </section>
</main>

<%- include('../partials/footer') %>